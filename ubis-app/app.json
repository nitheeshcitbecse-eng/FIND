{
  "expo": {
    "name": "UBIS Identification",
    "slug": "ubis-identification",
    "scheme": "ubisidentification",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.ubis.identification",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0B0F14"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "UBIS needs the camera to capture forensic evidence.",
          "photosPermission": "UBIS needs photo access to attach existing evidence images."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "UBIS records where a body was found."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0F14",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "image/*"
          ],
          "disableIOS": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "64700c37-a852-40fa-abd6-75d1188f98b2"
      }
    },
    "owner": "nitheesh_123"
  }
}
